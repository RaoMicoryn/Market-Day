{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api).*)", "destination": "/index.html" }],
  "functions": {
    "api/[...path].js": { "maxDuration": 30 },
    "api/index.js": { "maxDuration": 30 }
  }
}
