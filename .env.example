DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000

# Token perangkat Fonnte untuk mengirim OTP WhatsApp (https://fonnte.com).
FONNTE_TOKEN=replace-with-your-fonnte-token

# Opsional. Kunci HMAC untuk menyimpan hash kode OTP.
# Jika kosong, server memakai SESSION_SECRET.
OTP_SECRET=replace-with-another-long-random-secret

# Nomor WhatsApp admin/penjual untuk tombol "Konfirmasi pesanan via WhatsApp"
# setelah OTP berhasil diverifikasi. Format 08xxxxxxxxxx (tanpa +62).
VITE_SELLER_WHATSAPP=
